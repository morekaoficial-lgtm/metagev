# ===== Base de datos =====
POSTGRES_USER=gev
POSTGRES_PASSWORD=gev_secret
POSTGRES_DB=gev_evaluation
POSTGRES_PORT=5432

# URL completa usada por Prisma (backend)
DATABASE_URL=postgresql://gev:gev_secret@localhost:5432/gev_evaluation

# ===== Backend =====
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=cambiar_en_produccion
JWT_REFRESH_SECRET=cambiar_en_produccion_refresh
JWT_ACCESS_TTL=12h
JWT_REFRESH_TTL=7d

# Admin seed
ADMIN_EMAIL=admin@gev.local
ADMIN_PASSWORD=Admin123!

# SMTP (Gmail). Si quedan vacíos, los correos se imprimen en consola (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@gev.local

# Frontend
FRONTEND_URL=http://localhost:5173

# Zona horaria del programador de tareas (auto-cierre)
TZ=America/Mexico_City
